{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "notificationRecipients": {
      "$sensorUserKey": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          "enabled": {
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "thresholds": {
            ".validate": "newData.hasChildren(['minTemperature', 'maxTemperature', 'minHumidity', 'maxHumidity', 'minMoisture', 'maxMoisture', 'minLight', 'maxLight'])",
            "$threshold": {
              ".validate": "newData.isNumber()"
            }
          },
          "tokens": {
            "$tokenKey": {
              ".validate": "newData.hasChildren(['token', 'platform', 'updatedAt'])",
              "token": {
                ".validate": "newData.isString() && newData.val().length > 20"
              },
              "platform": {
                ".validate": "newData.val() == 'android' || newData.val() == 'ios'"
              },
              "updatedAt": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "notificationAlerts": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false,
        ".indexOn": ["timestamp"]
      }
    }
  }
}
